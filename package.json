{
  "name": "create-squirrel-opencode-harness",
  "version": "1.1.0",
  "description": "Scaffold squirrel opencode harness into .opencode directory",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "create-squirrel-opencode-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:tsc": "tsc",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "opencode",
    "harness",
    "scaffold",
    "cli"
  ],
  "author": "simiooo",
  "repository": {
    "type": "git",
    "url": "https://github.com/simiooo/create-squirrel-opencode-harness.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ejs": "^5.0.1",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "i18next": "^26.0.4",
    "i18next-fs-backend": "^2.6.3",
    "inquirer": "^13.4.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@vitest/ui": "^4.1.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "agents/**/*",
    "harness/**/*",
    "locales/**/*"
  ],
  "tsx": {
    "transpileOnly": false,
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "Bundler"
    }
  }
}
